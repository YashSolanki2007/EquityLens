# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/equity_research

# --- Local embeddings (preserves the existing pgvector index) ---
OLLAMA_BASE_URL=http://localhost:11434
# Used only if LLM_PROVIDER is explicitly changed back to ollama.
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024

# --- Hosted generation (planner, cards, analysis, and follow-up research) ---
# Add your development key from https://build.nvidia.com.
LLM_PROVIDER=nvidia
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- Follow-up deep research (current news) ---
# Free developer keys: https://app.tavily.com
# Without this key, deep research still checks official filings but is explicitly filing-only.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
DEEP_RESEARCH_LOOKBACK_DAYS=90
DEEP_RESEARCH_MAX_NEWS_QUERIES=3
DEEP_RESEARCH_MAX_NEWS_RESULTS=5
DEEP_RESEARCH_MAX_COMPANIES=3
DEEP_RESEARCH_DEADLINE_SECONDS=120

# --- NSE multi-timeframe technical scanner ---
# Yahoo's live WebSocket + yfinance historical backfill is enabled by default and
# needs no key. Set an Upstox token only to use its broker-backed candle feed.
UPSTOX_ACCESS_TOKEN=
UPSTOX_BASE_URL=https://api.upstox.com/v3
TECHNICAL_SCAN_CONCURRENCY=10
TECHNICAL_SCAN_MAX_RPS=40
TECHNICAL_SCAN_CANDLES=70
TECHNICAL_SCAN_CACHE_TTL_SECONDS=60
TECHNICAL_SCAN_DEADLINE_SECONDS=45
YAHOO_LIVE_STREAM_ENABLED=true

# --- SEC EDGAR ---
# Must be descriptive per SEC fair-access policy: AppName contact-email
SEC_USER_AGENT=EquityResearchPrototype developer@example.com
SEC_MAX_RPS=8

# --- App ---
API_HOST=0.0.0.0
API_PORT=8000
CACHE_DIR=data/cache
FILINGS_DIR=data/filings
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
